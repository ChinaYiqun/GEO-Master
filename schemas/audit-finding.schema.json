{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChinaYiqun/GEO-Master/schemas/audit-finding.schema.json",
  "title": "GEO-Master Audit Finding",
  "description": "Provider-neutral, evidence-linked finding emitted by technical GEO audit adapters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "project_id",
    "task_id",
    "target_url",
    "observed_at",
    "category",
    "check_id",
    "title",
    "status",
    "severity",
    "score",
    "max_score",
    "observed_summary",
    "remediation",
    "evidence",
    "source",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^FINDING-[A-F0-9]{20}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "crawler-access",
        "llm-readable-delivery",
        "structured-data",
        "page-metadata",
        "content-citability",
        "site-signals",
        "ai-discovery",
        "brand-entity"
      ]
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "warning", "not_evaluable"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "score": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "max_score": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "observed_summary": {
      "type": "string",
      "minLength": 1
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "action"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["open", "accepted", "completed", "not_required"]
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "location", "sha256", "json_pointer"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapter_version",
        "upstream_repository",
        "upstream_version",
        "upstream_schema_version"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "const": "geoready-cli"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "upstream_repository": {
          "type": "string",
          "const": "Auriti-Labs/geo-optimizer-skill"
        },
        "upstream_version": {
          "type": "string",
          "minLength": 1
        },
        "upstream_schema_version": {
          "type": ["integer", "string", "null"]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "notes"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unreviewed",
            "machine_reviewed",
            "human_reviewed",
            "disputed",
            "not_evaluable"
          ]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
